---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import { version } from "../lib/release";

// Astro.site comes from astro.config.mjs (SITE_URL or the production domain).
const site = Astro.site ?? new URL("https://nodebanana.app");
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/assets/og.png", site).href;

const title = "Node Banana: free, open source generative media canvas for Mac";
const description =
  "Node Banana is a free, open source generative media canvas for Mac, with Windows coming soon. Bring your own API keys and generate images, video, audio and 3D on one node graph, with an agent that builds workflows for you.";

// What search engines show beside the result: a free desktop app, its platforms, where it comes from.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Node Banana",
  url: site.href,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 13 or later (Apple Silicon); Windows coming soon",
  softwareVersion: version,
  downloadUrl: [new URL("/download/mac", site).href],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://github.com/shrimbly/node-banana/blob/master/LICENSE",
  screenshot: ogImage,
  image: ogImage,
  featureList: [
    "Node-based canvas for AI image, video, audio, 3D and text generation",
    "Bring your own API keys: Google Gemini, OpenAI, Anthropic, Replicate, fal.ai, Kie.ai, WaveSpeed, ComfyUI",
    "An agent that builds and edits workflows on your Claude Code or Codex subscription",
    "ComfyUI workflows run as nodes",
    "Every generated asset saved and browsable in an asset library",
    "Automatic updates",
  ],
  sameAs: ["https://github.com/shrimbly/node-banana", "https://discord.com/invite/89Nr6EKkTf", "https://node-banana-docs.vercel.app/"],
};
---
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0a0a0a">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Node Banana">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="Node Banana">
  <meta property="og:description" content="Free, open source, bring your own key. A generative media canvas for Mac, with Windows coming soon.">
  <link rel="canonical" href={pageUrl}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="The Node Banana app window: a car photo feeds Generate Image and Generate Video nodes, above the NODE BANANA wordmark.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Node Banana">
  <meta name="twitter:description" content="Free, open source, bring your own key. A generative media canvas for Mac, with Windows coming soon.">
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="The Node Banana app window: a car photo feeds Generate Image and Generate Video nodes, above the NODE BANANA wordmark.">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Node Banana for language models">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <link rel="icon" type="image/png" href="/assets/banana.png">
  <link rel="apple-touch-icon" href="/assets/banana.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@500&display=swap">
  <script is:inline>
    /* Entry animation gate. Lives here, not in site.js, so a failed script can never leave the page hidden. */
    (function (root) {
      root.classList.replace("no-js", "js");
      var go = function () { root.classList.add("ready"); };
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(go, go);
      setTimeout(go, 900);
    })(document.documentElement);
  </script>
</head>
<body>
  <slot />
  <script>
    import "../scripts/site.js";
  </script>
  {/* Vercel Web Analytics: page views, and the download clicks site.js sends
      as events. Cookieless, and nothing identifies a visitor. In production
      the script and its beacon come from this site's own /_vercel/insights/
      path, so the CSP's 'self' already allows them; the debug script from
      va.vercel-scripts.com is loaded only by `astro dev`. */}
  <Analytics />
</body>
</html>
